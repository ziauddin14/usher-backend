# Copy to backend/.env (never commit .env).
# Local: docker compose up -d  → mongodb://localhost:27017/ushr_demo_dev
# Atlas: mongodb+srv://ushr_demo_app:<password>@<cluster>/ushr_demo?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ushr_demo_dev

# 64 random characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=change-me-to-64-random-characters-change-me-to-64-random-chars

PORT=4000

# The web app origin (only needed when the browser calls the API directly; normally /api goes through the Next.js rewrite)
ALLOWED_ORIGIN=http://localhost:3000
