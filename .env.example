# Copy to .env (never commit .env). Placeholders only.
# Two databases on the same server: ushr_demo = invented seed data only, ushr_live = real imports only.
# MONGODB_URI is what the API (and pnpm seed) uses.
# Atlas: mongodb+srv://ushr_demo_app:<password>@<cluster>/ushr_demo?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ushr_demo

# pnpm import:employees / import:mobiles / import:villages always write here (the name must contain "live").
LIVE_MONGODB_URI=mongodb://localhost:27017/ushr_live

# 64 random characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=change-me-to-64-random-characters-change-me-to-64-random-chars

PORT=4000

# The web app origin (CORS allow-list; https:// in production). Normally the browser reaches the API
# through the frontend's /api rewrite, so this only matters for direct calls.
ALLOWED_ORIGIN=http://localhost:3000

# Proxies in front of the API that are trusted for the client IP: 1 locally, 2 on Render behind Vercel.
TRUST_PROXY_HOPS=1

# development | test | production (production: Secure cookie; refuses a local database / http origin)
NODE_ENV=development
